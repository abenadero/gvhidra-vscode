{
  "name": "gvhidra-vscode",
  "displayName": "GVHidra for VSCode",
  "icon": "assets/icons/logo256px.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.100.0"
  },
  "main": "./out/gvhidra-vscode.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gvhidra-vscode",
          "title": "GVHidra",
          "icon": "assets/icons/gvHIDRA-icon-solid-monochrome-64px.svg"
        }
      ]
    },
    "views": {
      "gvhidra-vscode": [
        {
          "id": "gvhidra-vscode.main",
          "name": "GVHidra",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "GVHidra",
      "properties": {
        "gvhidra.documentation.manualUrl": {
          "type": "string",
          "default": "https://example.com/manual",
          "description": "URL opened by the Manual button."
        },
        "gvhidra.documentation.wikiUrl": {
          "type": "string",
          "default": "https://example.com/wiki",
          "description": "URL opened by the Wiki button."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "^1.100.0",
    "typescript": "^5.0.0"
  }
}
