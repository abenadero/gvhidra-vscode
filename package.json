{
  "name": "gvhidra-vscode",
  "displayName": "GVHidra for VSCode",
  "description": "Apoyo al desarrollo gvHidra en entornos de la GVA con gvhidradev dentro de WSL.",
  "publisher": "abenadero",
  "icon": "assets/icons/logo256px.png",
  "version": "0.0.2",
  "license": "MIT",
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "gvhidra",
    "gvhidradev",
    "gva",
    "php",
    "wsl",
    "git",
    "svn",
    "xdebug",
    "php-cs-fixer",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/abenadero/gvhidra-vscode"
  },
  "bugs": {
    "url": "https://github.com/abenadero/gvhidra-vscode/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/gvhidra-vscode.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "gvhidra-vscode",
          "title": "GVHidra",
          "icon": "assets/icons/gvHIDRA-icon-solid-monochrome-64px.svg"
        }
      ]
    },
    "views": {
      "gvhidra-vscode": [
        {
          "id": "gvhidra-vscode.main",
          "name": "GVHidra",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "GVHidra",
      "properties": {
        "gvhidra.documentation.manualUrl": {
          "type": "string",
          "default": "https://example.com/manual",
          "description": "URL opened by the Manual button."
        },
        "gvhidra.documentation.wikiUrl": {
          "type": "string",
          "default": "https://example.com/wiki",
          "description": "URL opened by the Wiki button."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run clean && npm run compile",
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "compile": "tsc -p ./",
    "package": "vsce package --no-dependencies",
    "package:ls": "vsce ls --no-dependencies",
    "test": "npm run compile && node --test test/git-helper.test.cjs test/svn-helper.test.cjs test/codex-section.test.cjs test/utils-section.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.1.0",
    "typescript": "^5.0.0"
  }
}
